# NSEFO Environment Variables
# Copy this file to .env and fill in your values

# Dashboard (optional — dashboard is open if not set)
# NSEFO_DASHBOARD_SECRET=your-secret-here

# Credentials encryption key (auto-generated on first run if not set)
# NSEFO_CREDENTIALS_KEY=your-fernet-key-here

# Broker credentials (used by test_dns_debug.py for live testing)
ZERODHA_API_KEY=
ZERODHA_ENCTOKEN=

# Dhan / Fenix API (live trading)
# DHAN_CLIENT_ID=
# DHAN_ACCESS_TOKEN=
# DHAN_TOTP_SECRET=